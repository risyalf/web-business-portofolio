---
import { siteConfig } from '../config.ts';
import { Icon } from 'astro-icon/components';
import { portofoliosContent } from '../content/portofolios';

const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'erp', label: 'Enterprise & ERP' },
  { id: 'edtech', label: 'EdTech & Security' },
  { id: 'ecommerce', label: 'E-Commerce' },
  { id: 'web', label: 'Web & Landing Page' },
];
---

<section id="portofolios" class="relative bg-white border-t border-mono-lighter px-4 py-24 sm:px-6 lg:px-8">
  <!-- Aesthetic corner grid accents -->
  <div class="pointer-events-none absolute top-8 left-8 h-16 w-16 border-t-2 border-l-2 border-mono-lighter"></div>
  <div class="pointer-events-none absolute top-8 right-8 h-16 w-16 border-t-2 border-r-2 border-mono-lighter"></div>

  <div class="mx-auto max-w-7xl">
    <!-- Header -->
    <div class="scroll-fade-up mx-auto mb-14 max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-mono-lighter bg-mono-lighter/40 px-3 py-1 text-xs font-semibold tracking-wider uppercase text-mono-dark">
        <Icon name="heroicons:sparkles" class="h-3.5 w-3.5" />
        Selected Case Studies
      </span>
      <h2 class="text-mono-black mt-4 text-3xl font-extrabold sm:text-5xl tracking-tight">
        {siteConfig.portofolios.title}
      </h2>
      <p class="text-mono-dark mt-4 text-lg leading-relaxed">
        Solusi digital teruji dari arsitektur backend berkonkurensi tinggi, sistem CBT anti-curang, ERP operasional lapangan, hingga platform e-commerce berkonversi maksimal.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat.id}
            class={`portfolio-filter-btn px-4 py-2 text-sm font-medium rounded-full transition-all duration-200 cursor-pointer ${
              idx === 0
                ? 'bg-mono-black text-white shadow-sm'
                : 'bg-mono-lighter/60 text-mono-dark hover:bg-mono-lighter hover:text-mono-black'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Portfolio Grid -->
    <div id="portfolioGrid" class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      {
        portofoliosContent.map((item, index) => (
          <article
            data-category={item.category}
            class="portfolio-card group flex flex-col justify-between rounded-2xl border border-mono-lighter bg-white p-6 sm:p-8 transition-all duration-300 hover:border-mono-black hover:shadow-xl"
          >
            <div>
              <!-- Image Banner with Badges -->
              <div class="relative mb-6 overflow-hidden rounded-xl border border-mono-lighter bg-mono-lighter/30 aspect-video flex items-center justify-center">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  loading="lazy"
                  class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-end p-4">
                  {item.liveUrl && (
                    <a
                      href={item.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-lg bg-white px-3.5 py-1.5 text-xs font-semibold text-mono-black shadow-md transition-transform hover:scale-105"
                    >
                      <Icon name="heroicons:arrow-top-right-on-square" class="h-4 w-4" />
                      Preview Live
                    </a>
                  )}
                </div>

                <!-- Category & Timeline Badges -->
                <div class="absolute top-3 left-3 flex flex-wrap gap-2">
                  <span class="rounded-md bg-mono-black/85 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-sm">
                    {item.categoryLabel}
                  </span>
                  {item.badge && (
                    <span class="rounded-md bg-white/90 px-2.5 py-1 text-xs font-semibold text-mono-black backdrop-blur-sm border border-mono-lighter">
                      {item.badge}
                    </span>
                  )}
                </div>
                <div class="absolute top-3 right-3">
                  <span class="rounded-md bg-white/90 px-2 py-1 text-xs font-mono text-mono-dark backdrop-blur-sm border border-mono-lighter">
                    {item.timeline}
                  </span>
                </div>
              </div>

              <!-- Header Info -->
              <div class="mb-3 flex items-center justify-between text-xs text-mono-gray">
                <span class="font-medium text-mono-dark flex items-center gap-1.5">
                  <Icon name="heroicons:cpu-chip" class="h-3.5 w-3.5 text-mono-black" />
                  {item.role}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-mono-black text-xl sm:text-2xl font-bold tracking-tight group-hover:text-mono-dark transition-colors mb-3">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-mono-dark text-sm sm:text-base leading-relaxed mb-5">
                {item.description}
              </p>

              <!-- Key Highlights -->
              <div class="mb-6 rounded-xl bg-mono-lighter/30 p-4 border border-mono-lighter/60">
                <p class="text-xs font-bold uppercase tracking-wider text-mono-black mb-2.5 flex items-center gap-1.5">
                  <Icon name="heroicons:check-circle" class="h-4 w-4 text-mono-black" />
                  Key Architectural & Business Impact
                </p>
                <ul class="space-y-1.5 text-xs sm:text-sm text-mono-dark">
                  {item.highlights.map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-mono-black"></span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Footer: Tech Stack & Actions -->
            <div class="pt-4 border-t border-mono-lighter/80">
              <!-- Tech Badges -->
              <div class="mb-5 flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span class="rounded-md bg-mono-lighter/50 px-2.5 py-1 text-xs font-mono text-mono-darker border border-mono-lighter">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Action Links -->
              <div class="flex flex-wrap items-center gap-3">
                {item.liveUrl && (
                  <a
                    href={item.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg bg-mono-black px-4 py-2 text-xs sm:text-sm font-semibold text-white transition-all hover:bg-mono-dark"
                  >
                    <span>Kunjungi Live</span>
                    <Icon name="heroicons:arrow-top-right-on-square" class="h-4 w-4" />
                  </a>
                )}
                {item.repoUrl && (
                  <a
                    href={item.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg border border-mono-lighter bg-white px-4 py-2 text-xs sm:text-sm font-semibold text-mono-dark transition-all hover:border-mono-black hover:text-mono-black"
                  >
                    <Icon name="heroicons:code-bracket" class="h-4 w-4" />
                    <span>Demo Repository</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Dynamic portfolio filter tabs
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update active button state
        filterButtons.forEach((b) => {
          b.classList.remove('bg-mono-black', 'text-white', 'shadow-sm');
          b.classList.add('bg-mono-lighter/60', 'text-mono-dark');
        });
        btn.classList.remove('bg-mono-lighter/60', 'text-mono-dark');
        btn.classList.add('bg-mono-black', 'text-white', 'shadow-sm');

        // Filter cards
        cards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            card.style.display = 'flex';
            card.classList.add('animate-fade-in');
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
